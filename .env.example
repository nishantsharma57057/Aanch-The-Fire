NODE_ENV=production
PORT=3000
APP_URL=https://yourdomain.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=YOUR_FULL_DATABASE_NAME
DB_USER=YOUR_FULL_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
ADMIN_ACCOUNTS=GENERATE_WITH_NPM_RUN_ADMIN_ACCOUNTS
ADMIN_MFA_KEY=GENERATE_64_CHARACTER_HEX_KEY
RESEND_API_KEY=
MAIL_FROM=Aanch The Fire <no-reply@aanchthefire.com>

# Absolute admin session lifetime (0.5–24 hours). Sign out on shared devices.
ADMIN_SESSION_HOURS=12

# Razorpay Standard Checkout (keep KEY_SECRET server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
